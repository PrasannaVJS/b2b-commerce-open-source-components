<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
  <apiVersion>67</apiVersion>
  <isExposed>true</isExposed>
  <masterLabel>Search Results Grid</masterLabel>
  <description>Displays the search results with product card</description>
  <capabilities>
    <capability>lightning__ServerRenderableWithHydration</capability>
  </capabilities>
  <targets>
    <target>lightningCommunity__Page</target>
    <target>lightningCommunity__Default</target>
  </targets>
  <targetConfigs>
    <targetConfig targets="lightningCommunity__Page">
      <paletteSection>Open Code</paletteSection>
    </targetConfig>
    <targetConfig targets="lightningCommunity__Default">
      <property name="numberOfColumns" type="String" default="default" datasource="java://siteforce.customComponent.datasource.SearchResultsGridNumberOfColumnsDataSource" label="Number of Columns on Desktop" description="Columns dynamically adjust for smaller and larger devices."></property>
      <property name="numberOfColumnsOnMobile" type="String" default="2" datasource="1,2" label="Number of Columns on Mobile"></property>
      <property name="gridColumnSpacing" type="String" default="small" datasource="java://siteforce.customComponent.datasource.SLDSSpacingDataSource" label="Column Spacing"></property>
      <property name="gridRowSpacing" type="String" default="small" datasource="java://siteforce.customComponent.datasource.SLDSSpacingDataSource" label="Row Spacing"></property>
      <property name="resultNavigationType" type="String" default="pagination" datasource="java://siteforce.customComponent.datasource.SearchResultsNavigationTypeDataSource" label="Result Navigation" description="Select Load More or Pagination Only if you have a large catalog."></property>
      <property name="searchResults" type="String" default="{!Search.Results}" label="Results Data Binding" description="Bind to a Search Data Provider results object (e.g. {!Search.Results})."></property>
      <property name="total" type="String" default="{!Search.Results.total}" label="Total Results"></property>
      <property name="pageSize" type="String" default="{!Search.Results.pageSize}" label="Results Per Page"></property>
      <property name="currentPage" type="String" default="{!Search.Pagination.currentPage}" label="Current Page"></property>
      <property name="searchResultsLoading" type="String" default="{!Search.ClientState.loading}" label="Search Loading State Expression"></property>
      <property name="loadMoreLabel" label="Load More Button Label" type="String" default="Load More" translatable="true"></property>
      <property name="loadPreviousLabel" label="Load Previous Button Label" type="String" default="Load Previous" translatable="true"></property>
      <designLayout>
        <designSection name="Grid Layout">
          <designLayoutItems>
            <designLayoutProperty name="numberOfColumns"></designLayoutProperty>
            <designLayoutProperty name="numberOfColumnsOnMobile"></designLayoutProperty>
            <designLayoutProperty name="gridColumnSpacing"></designLayoutProperty>
            <designLayoutProperty name="gridRowSpacing"></designLayoutProperty>
          </designLayoutItems>
        </designSection>
        <designSection name="Results Data">
          <designLayoutItems>
            <designLayoutProperty name="resultNavigationType"></designLayoutProperty>
            <designLayoutProperty name="loadMoreLabel" cbVisibleIf="resultNavigationType=loadMore"></designLayoutProperty>
            <designLayoutProperty name="loadPreviousLabel" cbVisibleIf="resultNavigationType=loadMore"></designLayoutProperty>
            <designLayoutProperty name="searchResults"></designLayoutProperty>
            <designLayoutProperty name="total"></designLayoutProperty>
            <designLayoutProperty name="pageSize"></designLayoutProperty>
            <designLayoutProperty name="currentPage"></designLayoutProperty>
            <designLayoutProperty name="searchResultsLoading"></designLayoutProperty>
          </designLayoutItems>
        </designSection>
      </designLayout>
    </targetConfig>
  </targetConfigs>
</LightningComponentBundle>